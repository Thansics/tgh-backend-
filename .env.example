# Copy this file to .env for local testing (npm install dotenv first if you want
# to load it automatically — or just set these as real environment variables
# when deploying, e.g. in Render's dashboard).

# The password for /admin.html — CHANGE THIS before going live.
ADMIN_KEY=Thansics01

# Used to sign customer login sessions — CHANGE THIS before going live too.
# Any random long string works, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Email verification (required for registration to send real codes) ---
# Leave these blank and new accounts still work for testing — the
# verification code just gets printed to this server's console instead
# of emailed. See README.md > "Setting up email verification" for how
# to get a free Brevo API key.
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=Thansics Grandma's Honey

# --- Online payment via Paystack (optional) ---
# Leave these blank and customers just won't see a "Pay Online" button —
# orders still work as before (cash/WhatsApp-arranged payment). See
# README.md > "Setting up online payment" for how to get these.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Online payment via Paystack (optional) ---
# Leave these blank and the site still works — customers just won't see
# a "Pay Now" button, and orders stay pay-on-delivery/WhatsApp style.
# See README.md > "Setting up online payment" for how to get these.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- WhatsApp Cloud API (optional) ---
# Leave these blank and the site still works fine — it just won't send
# an automatic WhatsApp message to Grandma when a new order comes in.
# See README.md > "Setting up real WhatsApp order alerts" for how to get these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GRANDMA_WHATSAPP_NUMBER=2347071267515
